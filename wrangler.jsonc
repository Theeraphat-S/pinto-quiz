{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "pinto-quiz",
  "main": "src/worker.ts",
  "compatibility_date": "2026-10-07",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "assets": { "directory": "./dist", "binding": "ASSETS", "not_found_handling": "single-page-application", "run_worker_first": ["/api/*"] },
  "durable_objects": { "bindings": [
    { "name": "ACCOUNTS", "class_name": "AccountStore" },
    { "name": "ROOMS", "class_name": "QuizRoom" },
    { "name": "GUARDS", "class_name": "RateGuard" }
  ] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["AccountStore", "QuizRoom", "RateGuard"] }],
  "observability": { "enabled": true, "head_sampling_rate": 0.1 }
}
